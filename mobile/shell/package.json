{
  "name": "@mwavuli/mobile-shell",
  "version": "0.0.0",
  "private": true,
  "description": "The Mwavuli mobile app's shell: it picks a persona and mounts that portal, one at a time. The native projects are generated by `expo prebuild` and released locally with Fastlane.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --output-dir dist",
    "generate-native": "expo prebuild --no-install",
    "release-ios": "bundle exec fastlane ios beta",
    "release-android": "bundle exec fastlane android beta",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "catalog:native",
    "@expo-google-fonts/montserrat": "catalog:native",
    "@mwavuli/mobile-landlord": "workspace:*",
    "@mwavuli/mobile-ops": "workspace:*",
    "@mwavuli/mobile-tenant": "workspace:*",
    "@mwavuli/personas": "workspace:*",
    "@mwavuli/theme": "workspace:*",
    "expo": "catalog:native",
    "expo-font": "catalog:native",
    "expo-status-bar": "catalog:native",
    "expo-system-ui": "catalog:native",
    "nativewind": "catalog:native",
    "react": "catalog:native",
    "react-native": "catalog:native",
    "react-native-reanimated": "catalog:native",
    "react-native-safe-area-context": "catalog:native",
    "react-native-worklets": "catalog:native"
  },
  "devDependencies": {
    "@babel/core": "catalog:native",
    "@jest/globals": "catalog:native",
    "@react-native/jest-preset": "catalog:native",
    "@testing-library/react-native": "catalog:native",
    "@types/react": "catalog:native",
    "babel-plugin-dynamic-import-node": "catalog:native",
    "jest": "catalog:native",
    "jest-expo": "catalog:native",
    "react-dom": "catalog:native",
    "react-server-dom-webpack": "catalog:native",
    "tailwindcss": "catalog:native",
    "test-renderer": "catalog:native",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/empty-module.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|expo|@expo|@expo-google-fonts|nativewind|react-native-css-interop))"
    ]
  },
  "nx": {
    "name": "mobile-shell",
    "tags": [
      "platform:mobile",
      "type:shell"
    ]
  }
}
