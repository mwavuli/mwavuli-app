# Copy to fastlane/.env (git ignores it) and fill in. Fastlane loads fastlane/.env before every lane.
# Keys and certificates stay outside the repository: point at them by path.
MWAVULI_APP_ID=
APPLE_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
PLAY_JSON_KEY_PATH=
MWAVULI_UPLOAD_STORE_FILE=
MWAVULI_UPLOAD_STORE_PASSWORD=
MWAVULI_UPLOAD_KEY_ALIAS=
MWAVULI_UPLOAD_KEY_PASSWORD=
