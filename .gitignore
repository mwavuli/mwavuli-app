# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
# The bootstrap units keep their own state in git: a backend cannot hold the state of what creates it.
# These are the only state files allowed in version control, which is why a bootstrap unit may not
# create a resource with a secret attribute (infra/scripts/check-bootstrap-state.sh).
!infra/live/_bootstrap/*/tfstate/terraform.tfstate
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc
tfplan
*.tfplan

# --- Terragrunt ---
**/.terragrunt-cache/
terragrunt-debug.tfvars.json

# --- Astro ---
.astro/

# Agent worktrees. Sibling checkouts of this repository, not content of it —
# a plain `git add -A` otherwise stages another agent's entire working tree.
.claude/worktrees/

# --- Nx ---
.nx/

# --- Mobile: Expo and Fastlane ---
# The native projects are generated by `expo prebuild` from app.config.ts and are not committed.
mobile/*/ios/
mobile/*/android/
.expo/
expo-env.d.ts
.bundle/
mobile/*/vendor/
*.ipa
*.aab
*.apk
*.dSYM.zip
# Signing material and store credentials never go in git: Fastlane takes them by path from the environment.
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
**/fastlane/report.xml
**/fastlane/README.md
**/fastlane/Preview.html
**/fastlane/screenshots/
**/fastlane/test_output/
