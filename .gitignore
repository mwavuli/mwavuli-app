# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
# The Finder's custom folder icon file is "Icon" plus a carriage return. A bare `Icon?`
# also matches every `icons/` directory, because git ignores case on macOS.
Icon[[:cntrl:]]
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

