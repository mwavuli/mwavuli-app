            "id": "3260179755",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadTheReplicationConfiguration\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:ListBucket\",\n        \"s3:GetReplicationConfiguration\"\n      ],\n      \"Resource\": \"arn:aws:s3:::mwavuli-tfstate-prod-us-east-1\"\n    },\n    {\n      \"Sid\": \"ReadSourceVersions\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:GetObjectVersionTagging\",\n        \"s3:GetObjectVersionForReplication\",\n        \"s3:GetObjectVersionAcl\"\n      ],\n      \"Resource\": \"arn:aws:s3:::mwavuli-tfstate-prod-us-east-1/*\"\n    },\n    {\n      \"Sid\": \"WriteReplicas\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:ReplicateTags\",\n        \"s3:ReplicateObject\",\n        \"s3:ReplicateDelete\"\n      ],\n      \"Resource\": \"arn:aws:s3:::mwavuli-tfstate-prod-us-west-2/*\"\n    },\n    {\n      \"Sid\": \"DecryptSource\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"kms:Decrypt\",\n      \"Resource\": \"arn:aws:kms:us-east-1:341026626249:key/46a102bd-6af3-4503-881b-ecdb602a5512\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"kms:EncryptionContext:aws:s3:arn\": [\n            \"arn:aws:s3:::mwavuli-tfstate-prod-us-east-1\",\n            \"arn:aws:s3:::mwavuli-tfstate-prod-us-east-1/*\"\n          ],\n          \"kms:ViaService\": \"s3.us-east-1.amazonaws.com\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"EncryptReplicas\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:GenerateDataKey\",\n        \"kms:Encrypt\"\n      ],\n      \"Resource\": \"arn:aws:kms:us-west-2:341026626249:key/088614d1-0361-463b-a27c-7369b718249b\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"kms:EncryptionContext:aws:s3:arn\": [\n            \"arn:aws:s3:::mwavuli-tfstate-prod-us-west-2\",\n            \"arn:aws:s3:::mwavuli-tfstate-prod-us-west-2/*\"\n          ],\n          \"kms: