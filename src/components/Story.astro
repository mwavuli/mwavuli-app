---
import { STEPS } from '../data/story';
import Icon from './Icon.astro';
import StoryScene from './StoryScene.astro';

const total = STEPS.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="story" class="story bg-surface py-16 lg:py-24" aria-labelledby="story-title" data-story>
  <div class="mx-auto max-w-page px-4 sm:px-6 lg:px-8">
    <header class="max-w-2xl">
      <p class="font-display text-overline uppercase text-brand">How it works</p>
      <h2 id="story-title" class="mt-3 text-h2 lg:text-h1">Four steps, in plain words.</h2>
    </header>

    <!-- Each step holds its words and its panel. Without scripting, or below 1024 px, they
         stack, the panel above the words. With scripting on a wide screen the panels share one
         sticky cell and swap as the words scroll past. -->
    <div class="story__steps mt-10 lg:mt-12" style={`--steps: ${total}`}>
      {
        STEPS.map((step, i) => (
          <div class="step">
            <div class="step__text" data-step-text>
              <div class="flex items-center gap-4">
                <span class="tile">
                  <Icon name={step.icon} class="size-8" />
                </span>
                <p class="font-display text-overline uppercase text-brand">
                  Step {i + 1} of {total}
                </p>
              </div>
              <h3 class="mt-6 text-h1 lg:text-display">{step.title}</h3>
              <p class="mt-5 max-w-md text-body-lg">{step.body}</p>
              <p class="chip mt-8">
                <Icon name="check" class="size-5" />
                {step.chip}
              </p>
            </div>

            <figure class="step__panel panel" data-panel data-active={i === 0 ? '' : undefined} aria-hidden="true">
              <div class="panel__art">
                <StoryScene scene={(i + 1) as 1 | 2 | 3 | 4} />
              </div>
              <div class="panel__progress">
                <span class="panel__dots">
                  {STEPS.map((_, j) => <span class="dot" data-on={j === i ? '' : undefined} />)}
                </span>
                <span class="panel__count">
                  <b>{pad(i + 1)}</b> / {pad(total)}
                </span>
              </div>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Swap the sticky panel as the words scroll past: whichever step crosses a thin band across
  // the middle of the screen is the one shown. Without this script every panel stays in view.
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story && 'IntersectionObserver' in window) {
    const words = [...story.querySelectorAll<HTMLElement>('[data-step-text]')];
    const panels = [...story.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (i: number) => panels.forEach((p, n) => p.toggleAttribute('data-active', n === i));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) show(words.indexOf(e.target as HTMLElement));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    words.forEach((w) => io.observe(w));
  }
</script>
