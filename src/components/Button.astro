---
import type { HTMLAttributes } from 'astro/types';

// The primary button (brand A5): Green fill, white Montserrat 600 text, radius.md, 48 px high.
// Hover is one ramp step darker, pressed one more (brand S8). Focus uses the base-layer ring.
interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  /** With an href it renders a link; without one, a button. */
  href?: string;
  type?: 'button' | 'submit';
  /** "nav" trims the side padding on narrow phones so the header keeps the lockup's clear space. */
  size?: 'md' | 'nav';
}

const { href, type = 'button', size = 'md', class: className, ...attrs } = Astro.props;

const classes = [
  'motion-base group inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-brand',
  size === 'nav' ? 'px-3 min-[375px]:px-4 min-[393px]:px-6' : 'px-6',
  'font-display text-body font-semibold text-white hover:bg-brand-deep active:bg-green-900',
  className,
];
---

{
  href ? (
    <a href={href} {...attrs} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} {...attrs} class:list={classes}>
      <slot />
    </button>
  )
}
