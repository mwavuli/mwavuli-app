---
import { SLOPE } from '../data/scenes';

// Brand M2: a staggered pattern of outlined roofs, each with a small window, in a tone just
// darker than its ground. Roofs are 44 wide at the logo's slope; alternate rows are offset by
// half a roof. Used on light grounds only, behind quiet areas, never behind text.
const half = 22;
const drop = Math.round(SLOPE * half * 10) / 10;
const roof = (cx: number, apex: number) =>
  `M${cx - half} ${apex + drop}L${cx} ${apex}L${cx + half} ${apex + drop}`;
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <defs>
    {
      ['g50', 's100'].map((ground) => (
        <pattern id={`roofs-${ground}`} width="64" height="104" patternUnits="userSpaceOnUse">
          <g class={`roof-line roof-line--${ground}`}>
            <path d={roof(32, 8)} />
            <rect x="28" y="33" width="8" height="8" />
            <path d={roof(0, 60)} />
            <path d={roof(64, 60)} />
            <rect x="-4" y="85" width="8" height="8" />
            <rect x="60" y="85" width="8" height="8" />
          </g>
        </pattern>
      ))
    }
  </defs>
</svg>
