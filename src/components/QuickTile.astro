---
import Badge from './Badge.astro';
import Icon from './Icon.astro';

interface Props {
  /** The answer this tile jumps to. */
  href: string;
  /** Who it is for: "For owners". */
  tag: string;
  title: string;
  /** One short line, shown from the `sm` breakpoint up. */
  line: string;
  /** A pictogram file name from brand/icons/pictogram. It names the topic; the arrow is the action cue. */
  pictogram: string;
  /** The pictogram is already a rounded-square contact badge: do not set it inside another badge. */
  bare?: boolean;
}

const { href, tag, title, line, pictogram, bare = false } = Astro.props;
---

<!-- Sits on a Green ground (the hero), so the focus ring is the Gold one (brand S8). White surface,
     no shadow: reversed grounds do not use shadows (S4). Hover is one ramp step darker (S8). -->
<a
  href={href}
  class="group relative grid h-full w-full grid-cols-[auto_1fr_auto] items-center gap-x-4 rounded-lg bg-white p-4 transition-[background-color,transform] duration-[var(--mw-motion-duration-base)] ease-[var(--mw-motion-easing-standard)] hover:bg-green-50 active:bg-green-100 motion-safe:hover:-translate-y-1 sm:flex sm:flex-col sm:items-stretch sm:p-6"
>
  {
    bare ? (
      <Icon family="pictogram" name={pictogram} class="size-12 text-brand sm:size-14" />
    ) : (
      <Badge size="tile">
        <Icon family="pictogram" name={pictogram} class="h-8 text-accent" />
      </Badge>
    )
  }
  <span class="flex min-w-0 flex-col items-start gap-1 sm:mt-8 sm:flex-1 sm:gap-2">
    <span class="font-display text-h4 text-brand">{title}</span>
    <span
      class="order-first inline-flex rounded-full bg-green-50 px-3 py-0.5 text-label sm:py-1 text-brand transition-colors duration-[var(--mw-motion-duration-base)] group-hover:bg-white sm:absolute sm:right-6 sm:top-6 sm:order-none"
    >
      {tag}
    </span>
    <span class="hidden text-body text-ink sm:block sm:pr-10">{line}</span>
  </span>
  <Icon
    name="arrow-right"
    class="size-6 text-brand transition-transform duration-[var(--mw-motion-duration-base)] ease-[var(--mw-motion-easing-standard)] motion-safe:group-hover:translate-x-1 sm:absolute sm:bottom-6 sm:right-6"
  />
</a>
