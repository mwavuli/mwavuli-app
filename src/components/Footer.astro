---
import { band } from '../art/roof';
import { POSTAL_ADDRESS, SITE_NAME } from '../config';
import Lockup from './Lockup.astro';

const year = new Date().getFullYear();

// Two outlined roofs side by side, which read as the "M" for Mwavuli (brand M1), standing on the
// footer's rule. Each is a band at the logo's slope, cut square at its ends. They show only where
// there is room beside the tagline, so no art ever touches text (M3).
const roofs = [110, 330].map((apexX) => band(apexX, 18, 14, apexX - 110, apexX + 110));
---

<footer class="on-inverse bg-brand text-white">
  <div class="mx-auto max-w-page px-6 pt-16 lg:px-8 md:pt-20">
    <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-6">
      <!-- Brand L4 and L5: the reversed horizontal lockup at 195 px wide, with 24 px clear space. -->
      <Lockup reversed class="h-12" role="img" aria-label={SITE_NAME} />
      <nav aria-label="Footer">
        <ul>
          <li>
            <a
              href="/legal/privacy/"
              class="inline-flex min-h-12 items-center rounded-sm font-display text-body font-semibold underline-offset-4 hover:underline"
            >
              Privacy policy
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="relative mt-12 flex min-h-[8.75rem] items-center md:mt-16">
      <svg
        viewBox="0 0 440 140"
        class="pointer-events-none absolute bottom-0 right-0 hidden h-[8.75rem] w-[27.5rem] xl:block"
        aria-hidden="true"
        focusable="false"
      >
        {roofs.map((points, index) => <polygon points={points} class={index % 2 === 0 ? 'fill-green-700' : 'fill-green-900'} />)}
      </svg>
      <!-- The primary tagline (brand F6, D1): the first beat white, the second gold at large size. -->
      <p class="relative font-display text-h2 font-[720] text-white">
        <span class="block sm:inline">Your Property.</span>
        <span class="block text-accent sm:inline">Our Responsibility.</span>
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-white/20 py-6 text-body-sm">
      <p>© {year} {SITE_NAME}</p>
      <p>{POSTAL_ADDRESS}</p>
    </div>
  </div>
</footer>
