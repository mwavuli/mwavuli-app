---
import { SITE_DESCRIPTION, SITE_NAME } from '../config';
import Lockup from './Lockup.astro';

const year = new Date().getFullYear();
---

<footer class="on-inverse border-t border-white/20 bg-brand text-white">
  <div class="mx-auto max-w-page px-4 py-10 md:px-6 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <!-- 195 px wide (L5) with 48 px around it, past the 24 px of clear space (L4). -->
        <Lockup reversed class="h-12" role="img" aria-label={SITE_NAME} />
        <p class="mt-5 max-w-sm text-body-sm text-cream">{SITE_DESCRIPTION}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="grid gap-1 text-body-sm">
          <li>
            <a
              href="/legal/privacy/"
              class="inline-flex min-h-11 items-center rounded-sm underline-offset-4 hover:underline"
            >
              Privacy policy
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <p class="mt-8 border-t border-white/20 pt-5 text-caption text-cream">
      © {year}
      {SITE_NAME}
    </p>
  </div>
</footer>
