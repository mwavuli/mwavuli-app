---
import { POSTAL_ADDRESS, SITE_NAME } from '../config';
import { roofStack } from '../art/roof';
import Lockup from './Lockup.astro';

const year = new Date().getFullYear();

// M3: large roof bands cropped by the footer's edge, tone on tone, no gold.
const bands = roofStack(1040, 60, [
  { thickness: 150, className: 'fill-green-700' },
  { thickness: 70, className: 'fill-green-900' },
]);
---

<footer class="on-inverse relative isolate overflow-hidden bg-brand text-white">
  <svg
    class="pointer-events-none absolute inset-y-0 right-0 -z-10 h-full w-auto"
    viewBox="0 0 1200 520"
    preserveAspectRatio="xMaxYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    {bands.map((b) => <path d={b.d} class={b.className} />)}
  </svg>

  <div class="mx-auto max-w-page px-4 pb-8 pt-16 sm:px-6 lg:px-8 lg:pt-16">
    <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-8">
      <Lockup reversed class="h-12" role="img" aria-label={SITE_NAME} />
      <nav aria-label="Footer">
        <ul class="grid gap-1 text-body-sm">
          <li>
            <a href="/legal/privacy/" class="footer-link">Privacy policy</a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- F6: the primary tagline, both beats together, white then gold on Green. -->
    <p class="mt-12 font-display text-[clamp(2rem,6vw,4rem)] font-bold leading-[1.05] tracking-[-0.015em]">
      <span class="block sm:inline">Your Property.</span>
      <span class="block text-accent sm:inline"> Our Responsibility.</span>
    </p>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-white/20 pt-6 text-caption text-green-100"
    >
      <p>© {year} {SITE_NAME}</p>
      <p>{POSTAL_ADDRESS}</p>
    </div>
  </div>
</footer>
