---
import { POSTAL_ADDRESS, SITE_DESCRIPTION, SITE_NAME } from '../config';
import Lockup from './Lockup.astro';

const year = new Date().getFullYear();
---

<!-- Brand F1: the purpose, in the board's words, lives here. L4 and L5: lockup 195 px wide, 24 px clear. -->
<footer class="on-inverse bg-brand text-white">
  <div class="mx-auto max-w-page px-6 py-12 lg:px-8">
    <div class="grid gap-8 border-t border-white/20 pt-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6">
        <Lockup reversed class="h-12" role="img" aria-label={SITE_NAME} />
        <p class="mt-6 max-w-md text-body-lg text-green-100">{SITE_DESCRIPTION}</p>
      </div>
      <div class="lg:col-span-6 lg:justify-self-end">
        <nav aria-label="Footer">
          <ul class="grid gap-1 text-body">
            <li>
              <a
                href="/legal/privacy/"
                class="-mx-3 inline-flex min-h-12 items-center rounded-md px-3 font-display font-semibold transition-colors hover:bg-white/10"
              >
                Privacy policy
              </a>
            </li>
          </ul>
        </nav>
        <p class="mt-4 text-body text-green-100">{POSTAL_ADDRESS}</p>
      </div>
    </div>
    <p class="mt-12 text-caption text-green-100">© {year} {SITE_NAME}</p>
  </div>
</footer>
