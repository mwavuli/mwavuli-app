---
import { SITE_DESCRIPTION, SITE_NAME } from '../config';
import { SERVICES } from '../data/home';
import Lockup from './Lockup.astro';

const year = new Date().getFullYear();
const link =
  'inline-flex min-h-12 items-center rounded-sm text-body-sm text-white underline-offset-4 hover:underline';
---

<footer class="on-inverse border-t rule-inverse bg-brand text-white">
  <div class="mx-auto max-w-page px-6 py-12 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <Lockup reversed class="h-12" role="img" aria-label={SITE_NAME} />
        <p class="mt-6 max-w-sm text-body-lg text-white">{SITE_DESCRIPTION}</p>
      </div>
      <nav aria-label="Services" class="lg:col-span-5 lg:col-start-6">
        <p class="font-display text-overline uppercase text-cream">Services</p>
        <ul class="mt-3 grid gap-x-8 sm:grid-cols-2">
          {
            SERVICES.map((service) => (
              <li>
                <a href={service.href} class={link}>
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Footer" class="lg:col-span-2 lg:col-start-11">
        <p class="font-display text-overline uppercase text-cream">Site</p>
        <ul class="mt-3 grid">
          <li><a href="/#contact" class={link}>Contact</a></li>
          <li><a href="/legal/privacy/" class={link}>Privacy policy</a></li>
        </ul>
      </nav>
    </div>
    <p class="mt-8 border-t rule-inverse pt-6 text-caption text-cream">© {year} {SITE_NAME}</p>
  </div>
</footer>
