---
import { SITE_NAME } from '../config';
import { PURPOSE } from '../data/home';
import CornerBands from './CornerBands.astro';
import Lockup from './Lockup.astro';

interface Props {
  /** Leave room for a card that overlaps the footer's top edge. */
  overlap?: boolean;
}
const { overlap = false } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="on-inverse relative isolate overflow-hidden bg-brand text-white">
  <CornerBands class="pointer-events-none absolute bottom-0 right-0 -z-10 hidden w-48 -scale-y-100 md:block lg:w-80" />
  <div
    class:list={[
      'mx-auto max-w-page px-4 pb-10 sm:px-6 lg:px-8',
      overlap ? 'pt-44 lg:pt-48' : 'pt-16',
    ]}
  >
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-6">
        <Lockup reversed class="h-12" role="img" aria-label={SITE_NAME} />
        <p class="mt-6 max-w-md text-body text-white">{PURPOSE}</p>
      </div>
      <nav aria-label="Footer" class="lg:col-span-3">
        <p class="font-display text-overline uppercase text-white">More</p>
        <ul class="mt-3 grid gap-1 text-body-sm">
          <li>
            <a href="/legal/privacy/" class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">
              Privacy policy
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <p class="mt-12 border-t border-white/20 pt-6 text-caption">© {year} {SITE_NAME}</p>
  </div>
</footer>
