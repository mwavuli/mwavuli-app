---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  /** Side of the square: tile 48 px (56 from sm), md 56, lg 80, xl 112, 2xl 112 (144 from sm), 3xl 192. */
  size?: 'tile' | 'md' | 'lg' | 'xl' | '2xl' | '3xl';
  /** `brand` is the Green square; `deep` the darker ramp step, for a Green ground. */
  tone?: 'brand' | 'deep';
}

const { size = 'md', tone = 'brand', class: className, ...attrs } = Astro.props;

const sizes = {
  tile: 'size-12 sm:size-14',
  md: 'size-14',
  lg: 'size-20',
  xl: 'size-28',
  '2xl': 'size-28 sm:size-36',
  '3xl': 'size-48',
};
const tones = { brand: 'bg-brand', deep: 'bg-brand-deep' };
---

<!-- A rounded square behind an icon, radius 20 percent of its side (brand S3, I8). -->
<span
  {...attrs}
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded-[var(--mw-radius-badge)]',
    sizes[size],
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
