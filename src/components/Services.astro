---
import constructionRaw from '../../brand/icons/pictogram/construction-repairs.svg?raw';
import electricalRaw from '../../brand/icons/pictogram/electrical-plumbing.svg?raw';
import garbageRaw from '../../brand/icons/pictogram/garbage-management.svg?raw';
import rentalRaw from '../../brand/icons/pictogram/rental-income.svg?raw';
import tenantRaw from '../../brand/icons/pictogram/tenant-management.svg?raw';
import utilitiesRaw from '../../brand/icons/pictogram/utilities.svg?raw';

/*
 * The six services as on the business card (brand D15, I7), in sentence case. "Guaranteed" is
 * used only next to "we cover that first month", as the pitch rules in business/model.md
 * (BM18) require.
 */
const services = [
  {
    label: 'Guaranteed rental income',
    note: 'If a tenant doesn’t pay, we cover that first month.',
    svg: rentalRaw,
  },
  { label: 'Tenant management and sourcing', note: '', svg: tenantRaw },
  { label: 'Construction and repairs', note: '', svg: constructionRaw },
  { label: 'Electrical and plumbing services', note: '', svg: electricalRaw },
  { label: 'Utilities: electricity and water bills', note: '', svg: utilitiesRaw },
  { label: 'Garbage disposal and management', note: '', svg: garbageRaw },
];
---

<section id="services" class="bg-surface" aria-labelledby="services-title">
  <div class="mx-auto max-w-page px-6 py-24 lg:px-8 lg:py-32">
    <p class="font-display text-overline uppercase text-brand">Services</p>
    <h2 id="services-title" class="mt-4 max-w-3xl text-balance text-h2 sm:text-h1 lg:text-[3rem] lg:leading-[3.75rem]">
      Professional property management for people and businesses in Uganda.
    </h2>

    <ul class="mt-14 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
      {
        services.map((service) => (
          <li class="flex flex-col rounded-lg bg-green-50 p-6">
            <span
              class="block h-20 text-brand [&>svg]:h-full [&>svg]:w-auto"
              aria-hidden="true"
              set:html={service.svg}
            />
            <p class="mt-6 font-display text-body font-semibold text-heading">{service.label}</p>
            {service.note && <p class="mt-3 text-body-sm text-muted">{service.note}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>
