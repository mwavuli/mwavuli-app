---
import type { Statement } from '../data/audiences';

interface Props {
  statement: Statement;
}

const { statement } = Astro.props;
---

<!-- A monthly statement from the model's own worked example. It applies only the stated rule and is
     labelled as an illustration (brief: "Illustration, not a quote"). -->
<div class="overflow-hidden rounded-lg bg-surface shadow-md">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 bg-brand px-6 py-5 text-white lg:px-8">
    <h3 class="font-display text-h4 text-white">{statement.heading}</h3>
    <p class="rounded-full bg-slate-100 px-3 py-1 text-caption text-ink">Illustration, not a quote</p>
  </div>

  <div class="px-6 pb-2 pt-6 lg:px-8">
    <p class="text-body-sm text-muted">{statement.note}</p>
    <table class="mt-4 w-full text-body">
      <caption class="sr-only">{statement.heading}. Amounts in Ugandan shillings.</caption>
      <thead>
        <tr class="border-b border-line text-label text-muted">
          <th scope="col" class="py-3 text-left font-medium">Item</th>
          <th scope="col" class="py-3 text-right font-medium">UGX</th>
        </tr>
      </thead>
      <tbody>
        {
          statement.rows.map((row) => (
            <tr class="border-b border-line last:border-b-0">
              <th scope="row" class="py-4 pr-4 text-left font-normal text-ink">{row.label}</th>
              <td class="py-4 text-right tabular-nums text-ink">{row.amount}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-wrap items-end justify-between gap-x-6 gap-y-2 bg-green-50 px-6 py-6 lg:px-8">
    <p class="font-display text-h4 text-brand">{statement.totalLabel}</p>
    <p class="font-display text-brand">
      <span class="mr-2 text-label text-muted">UGX</span><span
        class="text-[length:clamp(2.25rem,4vw,3.5rem)] font-bold leading-none tabular-nums">{statement.total}</span
      >
    </p>
  </div>
</div>
