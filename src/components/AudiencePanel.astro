---
import type { Audience } from '../data/audiences';
import Button from './Button.astro';
import CornerFlag from './CornerFlag.astro';
import Icon from './Icon.astro';
import RoofArt from './RoofArt.astro';
import Statement from './Statement.astro';

interface Props {
  audience: Audience;
}

const { audience: a } = Astro.props;

const detail = a.detail;
const detailGround = a.id === 'tenants' ? 'bg-sage-100' : 'bg-green-50';
---

<section id={a.id} class:list={['aud-panel', `aud-${a.id}`]} aria-labelledby={`h-${a.id}`}>
  <!-- The hero: a full-bleed Green field, layered roof bands cropped by the edges, a corner flag. -->
  <div class="on-inverse relative overflow-hidden bg-brand text-white">
    <RoofArt
      kind={a.id}
      class="pointer-events-none absolute inset-x-0 bottom-0 h-[28rem] w-full md:inset-y-0 md:left-auto md:right-0 md:h-full md:w-1/2"
    />
    <CornerFlag
      tone={a.id === 'owners' ? 'hero-deep' : 'hero'}
      class="pointer-events-none absolute right-0 top-0 w-[6.5rem] md:w-[12.5rem]"
    />
    <div
      class="relative mx-auto max-w-page px-6 pb-[30rem] pt-[calc(var(--hdr-h)+2.5rem)] lg:px-8 md:pb-44 md:pt-[calc(var(--hdr-h)+3.5rem)] lg:min-h-[54rem]"
    >
      <div class="max-w-[40rem] md:max-w-[min(40rem,calc(50%-1.5rem))] lg:max-w-[44rem]">
        <h1 id={`h-${a.id}`} class="hero-h1">
          <span>{a.headline[0]}</span>
          <span class="hero-accent">{a.headline[1]}</span>
        </h1>
        <p class="mt-6 max-w-[34rem] text-pretty text-body-lg text-cream">{a.lead}</p>
        <Button href="#contact" variant="light" class="mt-8">Contact us</Button>
      </div>
    </div>
  </div>

  <!-- Three facts on white cards that overlap the hero's bottom edge. -->
  <div class="relative z-10 mx-auto -mt-12 max-w-page px-6 md:-mt-24 lg:px-8">
    <ul class="grid gap-6 md:grid-cols-3">
      {
        a.facts.map((fact) => (
          <li class="rounded-lg bg-surface p-6 shadow-md md:p-8">
            {fact.figure ? (
              <h2 class="font-display font-[750] leading-none text-brand">
                <span class="sr-only">{fact.figure.label}</span>
                <span class="flex items-baseline gap-1" aria-hidden="true">
                  <span class="fact-figure">{fact.figure.value}</span>
                  {fact.figure.unit && <span class="text-h3">{fact.figure.unit}</span>}
                </span>
              </h2>
            ) : (
              <>
                <span class="grid size-24 place-items-center rounded-lg bg-brand text-cream">
                  <Icon name={fact.icon ?? 'check'} class="size-14" />
                </span>
                <h2 class="mt-6 font-display text-h3 text-brand">{fact.title}</h2>
              </>
            )}
            <p class="mt-4 text-body text-ink">{fact.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- The detail: asymmetric, on a tinted ground with flat roof bands behind the card. -->
  <div class:list={['relative mt-16 overflow-hidden md:mt-24', detailGround]}>
    <CornerFlag
      tone={a.id === 'tenants' ? 'sage' : 'light'}
      class="pointer-events-none absolute left-0 top-0 hidden w-28 -scale-x-100 md:block lg:w-44"
    />
    <div class="relative mx-auto grid max-w-page gap-12 px-6 py-20 lg:px-8 md:py-24 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="font-display text-overline uppercase text-brand">{detail.overline}</p>
        <h2 class="mt-4 text-balance text-h2">{detail.title}</h2>
        <p class="mt-4 max-w-md text-body-lg text-ink">{detail.text}</p>
        {
          detail.kind === 'statement' && detail.placeholder && (
            <div class="mt-8 max-w-md rounded-lg border border-line-strong bg-surface p-5" role="note">
              <p class="inline-flex items-center gap-2 rounded-full bg-gold-100 px-3 py-1 text-caption text-ink">
                <Icon name="alerts" class="size-4" />
                Placeholder
              </p>
              <p class="mt-3 text-body text-ink">{detail.placeholder}</p>
            </div>
          )
        }
      </div>
      <div class="lg:col-span-7">
        {
          detail.kind === 'statement' ? (
            <Statement statement={detail.statement} />
          ) : (
            <div class="rounded-lg bg-surface p-6 shadow-md md:p-8">
              <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
                {detail.items.map((item) => (
                  <li class="flex gap-4">
                    <span class="grid size-12 shrink-0 place-items-center rounded-md bg-green-50 text-brand">
                      <Icon name={item.icon} class="size-6" />
                    </span>
                    <div>
                      <h3 class="font-display text-h4 text-brand">{item.title}</h3>
                      <p class="mt-1 text-body text-ink">{item.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
