---
import type { HTMLAttributes } from 'astro/types';

// Brand line icons (I1, I11): the supplied SVGs, inlined so `currentColor` and the 1.5 px stroke
// scale with the size set by the caller's class.
const lineIcons = import.meta.glob<string>('../../brand/icons/line/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props extends HTMLAttributes<'span'> {
  /** File name in brand/icons/line without the extension, e.g. "arrow-right". */
  name: string;
  /** A text alternative for an icon that carries meaning (I10). Decorative icons omit it. */
  label?: string;
}

const { name, label, class: className, ...attrs } = Astro.props;
const svg = lineIcons[`../../brand/icons/line/${name}.svg`];
if (!svg) throw new Error(`Unknown line icon: ${name}`);
---

<span
  {...attrs}
  class:list={['inline-flex shrink-0 [&>svg]:size-full', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>
