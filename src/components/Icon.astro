---
import type { HTMLAttributes } from 'astro/types';

// The brand's own artwork, read in place and inlined so `currentColor` works (brand I11).
const line = import.meta.glob<string>('../../brand/icons/line/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const pictogram = import.meta.glob<string>('../../brand/icons/pictogram/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props extends HTMLAttributes<'span'> {
  name: string;
  family?: 'line' | 'pictogram';
  /** A meaning-bearing icon passes a label. Decorative icons are hidden from assistive technology (I10). */
  label?: string;
}

const { name, family = 'line', label, class: className, ...attrs } = Astro.props;

const key = `../../brand/icons/${family}/${name}.svg`;
const svg = (family === 'line' ? line : pictogram)[key];
if (!svg) {
  throw new Error(`No ${family} icon named ${name}`);
}
---

<span
  {...attrs}
  class:list={['inline-flex shrink-0 [&>svg]:h-full [&>svg]:w-auto', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>
