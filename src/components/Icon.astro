---
// Inlines an SVG from brand/icons so `currentColor` works (brand I11). Line icons and pictograms are
// decorative here: each sits beside a visible label (I10), so they are hidden from assistive tech.
interface Props {
  name: string;
  kind?: 'line' | 'pictogram';
  class?: string;
}

const line = import.meta.glob<string>('../../brand/icons/line/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const pictogram = import.meta.glob<string>('../../brand/icons/pictogram/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const { name, kind = 'line', class: className = '' } = Astro.props;
const raw = (kind === 'line' ? line : pictogram)[`../../brand/icons/${kind}/${name}.svg`];
if (!raw) throw new Error(`Unknown ${kind} icon: ${name}`);

// The files carry a fixed width and height; drop them so CSS sets the size and the viewBox keeps the
// ratio. Pictograms differ in aspect ratio, so they align to the left of their box.
const align = kind === 'pictogram' ? ' preserveAspectRatio="xMinYMid meet"' : '';
const svg = raw.replace(
  /<svg ([^>]*?) width="[\d.]+" height="[\d.]+"/,
  `<svg $1 class="${className}" aria-hidden="true" focusable="false"${align}`,
);
---

<Fragment set:html={svg} />
