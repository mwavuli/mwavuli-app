---
import type { HTMLAttributes } from 'astro/types';

// The brand's icon files (brand I11): inlined so `currentColor` carries the colour. The
// files are the source; nothing is redrawn or recoloured here.
const line = import.meta.glob<string>('../../brand/icons/line/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const pictogram = import.meta.glob<string>('../../brand/icons/pictogram/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props extends HTMLAttributes<'span'> {
  /** File name without extension, as in the catalog (brand I6). */
  name: string;
  /** Line icons for the interface, pictograms and badges for services and contact (brand I1). */
  family?: 'line' | 'pictogram';
}

const { name, family = 'line', class: className, ...attrs } = Astro.props;

const files = family === 'line' ? line : pictogram;
const raw = files[`../../brand/icons/${family}/${name}.svg`];
if (!raw) throw new Error(`Unknown ${family} icon: ${name}`);

// The files declare a fixed width and height; the viewBox keeps the ratio and CSS sets the
// size (for example class="size-6").
const svg = raw.replace(/ width="[\d.]+" height="[\d.]+"/, '');
---

<span
  aria-hidden="true"
  {...attrs}
  class:list={['inline-flex shrink-0 [&>svg]:h-full [&>svg]:w-full', className]}
  set:html={svg}
/>
