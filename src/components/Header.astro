---
import { SITE_NAME } from '../config';
import Lockup from './Lockup.astro';
---

<!-- Brand L4/L5: the horizontal lockup is 195 px wide (h-12) with 24 px clear space (one eighth of its width). -->
<header class="bg-page">
  <div class="mx-auto flex max-w-page items-center justify-between gap-4 px-6 py-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${SITE_NAME}: home`}>
      <Lockup class="h-12" aria-hidden="true" />
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-2 sm:gap-4">
        <li class="hidden sm:block">
          <a
            href="/#services"
            class="inline-flex min-h-12 items-center rounded-md px-4 font-display text-body font-semibold text-ink transition-colors duration-[var(--mw-motion-duration-fast)] hover:bg-green-50 hover:text-brand active:bg-green-100"
          >
            Services
          </a>
        </li>
        <li>
          <a
            href="/#contact"
            class="inline-flex min-h-12 items-center rounded-md bg-brand px-6 font-display text-body font-semibold text-white transition-colors duration-[var(--mw-motion-duration-fast)] hover:bg-brand-deep active:bg-green-900"
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
