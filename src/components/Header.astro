---
import { SITE_NAME } from '../config';
import Button from './Button.astro';
import Lockup from './Lockup.astro';

interface Props {
  /** `green` floats the header, in the reversed colours, over a Green hero. */
  tone?: 'light' | 'green';
}

const { tone = 'light' } = Astro.props;
const green = tone === 'green';

// The horizontal lockup at h-12 is 195 px wide, above the 180 px minimum (brand L5), with
// 24 px of clear space on every side (one eighth of its width, L4).
const links = [
  { href: '/#how', label: 'How it works' },
  { href: '/#services', label: 'What we look after' },
];
---

<header class:list={green ? 'on-inverse absolute inset-x-0 top-0 z-20 text-white' : 'bg-page'}>
  <div class="mx-auto flex max-w-page items-center justify-between gap-3 px-6 py-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center rounded-sm" aria-label={`${SITE_NAME}: home`}>
      <Lockup reversed={green} class="h-12" aria-hidden="true" />
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-2 md:gap-6">
        {
          links.map((link) => (
            <li class="hidden md:block">
              <a
                href={link.href}
                class:list={[
                  'mw-transition inline-flex min-h-12 items-center rounded-sm px-1 font-display text-label font-semibold underline-offset-8 hover:underline',
                  green ? 'text-white' : 'text-ink hover:text-brand',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <Button href="/#contact" tone={green ? 'inverse' : 'primary'} class="max-sm:px-5">
            Contact
          </Button>
        </li>
      </ul>
    </nav>
  </div>
</header>
