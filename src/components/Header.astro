---
import { SITE_NAME } from '../config';
import { NAV, SERVICES } from '../data/home';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Lockup from './Lockup.astro';

const motion = 'motion-colors';
const navLink = `inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-md px-4 font-display text-body font-semibold text-white ${motion} hover:bg-brand-deep active:bg-green-900`;
const panelLink = `group/item flex items-center gap-4 rounded-lg p-2 ${motion} hover:bg-green-50 active:bg-green-100 lg:p-3`;
const badge =
  'motion-colors flex size-12 shrink-0 items-center justify-center rounded-(--mw-radius-badge) bg-green-50 text-brand group-hover/item:bg-white lg:size-14';
---

<header class="on-inverse relative z-40 border-b rule-inverse bg-brand text-white">
  <div class="mx-auto flex max-w-page items-center justify-between gap-6 px-6 py-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center rounded-sm" aria-label={`${SITE_NAME}: home`}>
      <Lockup reversed class="h-12" aria-hidden="true" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        <li>
          <details class="group" data-dropdown>
            <summary class:list={[navLink, 'group-open:bg-brand-deep']}>
              Services
              <Icon
                name="chevron-down"
                class="size-5 transition-transform duration-(--mw-motion-duration-base) ease-(--mw-motion-easing-standard) group-open:rotate-180 motion-reduce:transition-none"
              />
            </summary>
            <div class="on-surface absolute inset-x-0 top-full z-50 pt-2">
              <div class="mx-auto max-w-page px-8">
                <div
                  class="grid gap-2 rounded-xl border border-line bg-surface p-3 text-ink shadow-lg lg:grid-cols-[17rem_1fr]"
                >
                  <div class="flex flex-col justify-between rounded-lg bg-green-50 p-6">
                    <div>
                      <p class="font-display text-overline uppercase text-brand">Services</p>
                      <p class="mt-3 font-display text-h3 text-heading">Six services, one agreement.</p>
                    </div>
                    <a
                      href="/#contact"
                      class={`-ml-3 mt-8 inline-flex min-h-12 items-center gap-2 rounded-md px-3 font-display font-semibold text-brand ${motion} hover:text-brand-deep`}
                    >
                      Talk to us
                      <Icon name="arrow-right" class="size-5" />
                    </a>
                  </div>
                  <ul class="grid gap-1 lg:grid-cols-2 xl:grid-cols-3">
                    {
                      SERVICES.map((service) => (
                        <li>
                          <a href={service.href} class={`${panelLink} h-full items-start`}>
                            <span class={badge}>
                              <Icon family="pictogram" name={service.id} class="size-8 lg:size-10" />
                            </span>
                            <span>
                              <span class="block font-display text-body font-semibold text-heading">
                                {service.name}
                              </span>
                              <span class="mt-1 block text-body-sm text-ink">{service.line}</span>
                            </span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </details>
        </li>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class={navLink}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="ml-3">
          <Button href="/#contact" variant="inverse">Contact us</Button>
        </li>
      </ul>
    </nav>

    <details class="group lg:hidden" data-dropdown>
      <summary
        class={`inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-md border rule-inverse px-3 font-display text-body font-semibold text-white ${motion} hover:bg-brand-deep group-open:bg-brand-deep`}
      >
        <span class="inline-flex group-open:hidden"><Icon name="menu" class="size-6" /></span>
        <span class="hidden group-open:inline-flex"><Icon name="close" class="size-6" /></span>
        <span class="sr-only min-[380px]:not-sr-only">Menu</span>
      </summary>
      <div class="on-surface absolute inset-x-0 top-full z-50 pt-2">
        <div class="mx-auto max-w-page px-6">
          <div
            class="max-h-[calc(100dvh-9rem)] overflow-y-auto rounded-xl border border-line bg-surface p-3 text-ink shadow-lg"
          >
            <p class="px-3 pt-3 font-display text-overline uppercase text-brand">Services</p>
            <ul class="mt-2">
              {
                SERVICES.map((service) => (
                  <li>
                    <a href={service.href} class={panelLink}>
                      <span class={badge}>
                        <Icon family="pictogram" name={service.id} class="size-8" />
                      </span>
                      <span class="font-display text-body font-semibold text-heading">{service.name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="px-3 pt-6 font-display text-overline uppercase text-brand">Explore</p>
            <ul class="mt-2">
              {
                NAV.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class={`flex min-h-12 items-center rounded-lg px-3 font-display text-body font-semibold text-heading ${motion} hover:bg-green-50 active:bg-green-100`}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="p-3 pt-6">
              <Button href="/#contact" class="w-full">Contact us</Button>
            </div>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement. The menus are <details> elements and work without this script:
  // it only closes an open one on Escape, on a click outside it, when focus leaves it, and
  // when a link inside it is followed.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown]'));

  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      for (const other of menus) if (other !== menu) other.open = false;
    });
    menu.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (next instanceof Node && !menu.contains(next)) menu.open = false;
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
  }

  document.addEventListener('pointerdown', (event) => {
    for (const menu of menus) {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (!menu.open) continue;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
