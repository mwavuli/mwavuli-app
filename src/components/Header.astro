---
import { SITE_NAME } from '../config';
import Lockup from './Lockup.astro';
---

<header class="border-b border-line bg-page">
  <div class="mx-auto flex max-w-page items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${SITE_NAME}: home`}>
      <Lockup class="h-8" aria-hidden="true" />
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-2 sm:gap-4">
        <li>
          <a
            href="/legal/privacy/"
            class="inline-flex min-h-11 items-center px-3 font-display text-label font-semibold text-ink hover:text-brand"
          >
            Privacy
          </a>
        </li>
        <li>
          <a
            href="/#contact"
            class="inline-flex min-h-11 items-center rounded-full bg-brand px-5 font-display text-label font-semibold text-white hover:bg-brand-deep"
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
