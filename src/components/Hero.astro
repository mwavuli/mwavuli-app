---
import { AREA } from '../data/home';
import EnquiryCard from './EnquiryCard.astro';
import Icon from './Icon.astro';
import RoofArt from './RoofArt.astro';

// The first screen: a full-bleed Green field, the two-beat headline (F6), the proof line and the
// roof composition (M3), with the enquiry card overlapping the field's lower edge.
---

<div class="relative">
  <section class="on-inverse relative isolate overflow-hidden bg-brand text-white" aria-labelledby="hero-title">
    <RoofArt class="pointer-events-none absolute right-0 top-0 -z-10 h-[13rem] w-full md:h-[18rem] md:w-auto lg:right-[min(0px,calc((100vw_-_1440px)*0.4))] lg:h-full" />
    <div class="mx-auto max-w-page px-4 pb-44 pt-[14rem] sm:px-6 md:pt-[19.5rem] lg:px-8 lg:pb-48 lg:pt-16">
      <h1 id="hero-title" class="font-display text-hero text-white">
        <span class="block">Managed Properties.</span>
        <span class="block text-accent">Better Living.</span>
      </h1>
      <div class="mt-6 h-1 w-16 bg-accent" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl font-display text-h4 text-white lg:text-h3">
        Rent paid to you on the 1st, every month.
      </p>
      <p class="mt-6 flex items-center gap-2 text-body-sm text-white">
        <Icon name="location" class="size-5" />
        {AREA}
      </p>
    </div>
  </section>

  <div class="relative z-10 mx-auto -mt-32 max-w-page px-4 sm:px-6 lg:px-8">
    <EnquiryCard />
  </div>
</div>
