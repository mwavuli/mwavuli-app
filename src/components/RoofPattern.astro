---
interface Props {
  /** Unique within the page: the pattern is referenced by id. */
  id: string;
  /** Sets the stroke colour through `color`, for example `roof-pattern-cream`. */
  class?: string;
}

const { id, class: className } = Astro.props;
---

<!-- Brand M2: staggered outlined roofs, each with a small window, 64 px wide, alternate rows
     offset by half a roof. The stroke is `currentColor`, mixed from the ground it sits on.
     Light grounds only, and never behind text. -->
<svg
  aria-hidden="true"
  focusable="false"
  class:list={['pointer-events-none absolute inset-0 h-full w-full', className]}
>
  <defs>
    <pattern id={id} width="64" height="80" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 27.2 32 3l26 24.2"></path>
        <rect x="28.5" y="15" width="7" height="7"></rect>
        <path d="M-26 67.2 0 43l26 24.2"></path>
        <rect x="-3.5" y="55" width="7" height="7"></rect>
        <path d="M38 67.2 64 43l26 24.2"></path>
        <rect x="60.5" y="55" width="7" height="7"></rect>
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>
