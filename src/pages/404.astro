---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="The page you were looking for does not exist.">
  <section class="mx-auto flex max-w-3xl flex-col items-start px-4 py-24 sm:px-6">
    <p class="font-display text-overline uppercase text-brand">404</p>
    <h1 class="mt-2 text-h1">Page not found</h1>
    <p class="mt-4 text-body-lg text-muted">
      The page you were looking for doesn't exist or has moved.
    </p>
    <a href="/" class="btn btn--solid mt-8">Back to the homepage</a>
  </section>
</Layout>
