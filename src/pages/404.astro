---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="The page you were looking for does not exist.">
  <section class="mx-auto flex max-w-3xl flex-col items-start px-6 py-24 lg:px-8">
    <p class="font-display text-overline uppercase text-brand">404</p>
    <h1 class="mt-2 text-h1">Page not found</h1>
    <p class="mt-4 text-body-lg text-muted">
      The page you were looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-12 items-center rounded-md bg-brand px-6 font-display text-body font-semibold text-white transition-colors duration-(--mw-motion-duration-base) hover:bg-brand-deep active:bg-green-900 motion-reduce:transition-none"
    >
      Back to the homepage
    </a>
  </section>
</Layout>
