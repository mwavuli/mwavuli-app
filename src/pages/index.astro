---
import AudienceHeader from '../components/AudienceHeader.astro';
import AudiencePanel from '../components/AudiencePanel.astro';
import ContactSection from '../components/ContactSection.astro';
import ServicesBand from '../components/ServicesBand.astro';
import { AUDIENCES } from '../data/audiences';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <AudienceHeader slot="header" />
  {AUDIENCES.map((audience) => <AudiencePanel audience={audience} />)}
  <ServicesBand />
  <ContactSection />
</Layout>

<script>
  // Progressive enhancement. The radios already switch the page with CSS alone. This makes a link
  // such as /#tenants open the right page, keeps the address in step with the choice, and lets the
  // new page fade in.
  const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="audience"]'));

  function openFromHash() {
    const radio = radios.find((item) => item.value === location.hash.slice(1));
    if (radio && !radio.checked) {
      document.body.dataset.switched = '';
      radio.checked = true;
    }
  }

  for (const radio of radios) {
    radio.addEventListener('change', () => {
      document.body.dataset.switched = '';
      history.replaceState(null, '', `#${radio.value}`);
    });
  }

  addEventListener('hashchange', openFromHash);
  openFromHash();
</script>
