---
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Placeholder from '../components/Placeholder.astro';
import QuickTile from '../components/QuickTile.astro';
import RoofBands from '../components/RoofBands.astro';
import { POSTAL_ADDRESS } from '../config';
import Layout from '../layouts/Layout.astro';

// What each visitor came to do. Each tile jumps to one short answer further down this page.
const tiles = [
  {
    href: '#paid',
    tag: 'For owners',
    title: 'How you are paid',
    line: 'One payment, one statement, on the 1st.',
    pictogram: 'rental-income',
  },
  {
    href: '#rent',
    tag: 'For tenants',
    title: 'Pay your rent',
    line: 'By mobile money or bank. Never cash.',
    pictogram: 'tenant-management',
  },
  {
    href: '#problem',
    tag: 'For tenants',
    title: 'Report a problem',
    line: 'Tell us by phone or WhatsApp.',
    pictogram: 'construction-repairs',
  },
  {
    href: '#contact',
    tag: 'For everyone',
    title: 'Talk to us',
    line: 'Phone, WhatsApp or post.',
    pictogram: 'badge-phone',
    bare: true,
  },
];

// The three numbers an owner needs to remember (business/model.md, BM18), quoted as written.
const facts = [
  { figure: '1', unit: 'st', text: 'We pay you on the 1st, for every room with a tenant.' },
  { figure: '15', unit: '%', text: 'We take 15% of the rent. No rent, no fee.' },
  { figure: '30', unit: 'days', text: 'Leave any time with 30 days’ notice.' },
];

// The six services on the business card (brand F1, I7).
const services = [
  { name: 'rental-income', label: 'Guaranteed rental income', height: 'h-14' },
  { name: 'tenant-management', label: 'Tenant management and sourcing', height: 'h-14' },
  { name: 'construction-repairs', label: 'Construction and repairs', height: 'h-16' },
  { name: 'electrical-plumbing', label: 'Electrical and plumbing', height: 'h-16' },
  { name: 'utilities', label: 'Utilities: electricity and water bills', height: 'h-16' },
  { name: 'garbage-management', label: 'Garbage disposal and management', height: 'h-16' },
];
---

<Layout title="Home">
  <!-- 1 · Hero. A Green field with layered roof bands bleeding off the edges; the four tiles sit on
       the bands. Everything focusable here is on a Green ground, so the focus ring is Gold. -->
  <section aria-label="Start here" class="on-inverse relative isolate overflow-hidden bg-brand text-white">
    <RoofBands variant="hero" />
    <div class="relative mx-auto max-w-page px-6 pb-14 pt-8 md:pt-14 lg:px-8 lg:pb-14 lg:pt-12">
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-8 md:gap-y-12">
        <div class="relative z-10 md:col-span-7">
          <h1 class="font-display text-display-xl text-white">
            <span class="block">Managed Properties.</span>
            <span class="block text-accent">Better Living.</span>
          </h1>
          <div class="mt-6 h-1 w-16 bg-accent lg:mt-8" aria-hidden="true"></div>
          <p class="mt-4 max-w-xs text-balance font-sans text-h4 text-white md:max-w-xs lg:mt-6 lg:max-w-none">Rent paid to you on the 1st, every month.</p>
        </div>

        <div class="relative order-last md:order-none md:col-span-5 md:self-start">
          <RoofBands variant="slot" />
          <PhotoSlot
            class="-mx-6 -mb-14 aspect-[393/160] max-h-52 md:m-0 md:aspect-[4/3] md:max-h-none md:rounded-xl"
          />
        </div>

        <div id="start" class="relative z-10 scroll-mt-6 md:col-span-12">
          <h2 id="start-heading" class="font-display text-body font-semibold text-cream">What do you want to do?</h2>
          <nav aria-labelledby="start-heading" class="mt-4">
            <ul class="grid gap-2 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4 xl:gap-6">
              {
                tiles.map((tile) => (
                  <li class="flex">
                    <QuickTile {...tile} />
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Owners, on white. Big numerals carry the answer: 1st, 15%, 30 days. -->
  <section id="paid" aria-labelledby="paid-heading" class="scroll-mt-6 bg-surface py-16 md:py-24">
    <div class="mx-auto max-w-page px-6 lg:px-8">
      <div class="grid items-end gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="font-display text-overline uppercase text-brand">For owners and investors</p>
          <h2 id="paid-heading" class="mt-4 text-h1 md:text-display">How you are paid</h2>
          <span class="arrival-rule mt-4 block h-1 w-16 bg-accent" aria-hidden="true"></span>
          <p class="mt-4 max-w-xl text-body-lg">One payment and one statement a month, by SMS or WhatsApp.</p>
        </div>
        <div class="hidden justify-end lg:col-span-4 lg:flex">
          <Badge size="3xl">
            <Icon family="pictogram" name="rental-income" class="h-20 text-accent" />
          </Badge>
        </div>
      </div>

      <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-20">
        {
          facts.map((fact) => (
            <li class="border-t border-line-strong pt-6">
              <p class="flex items-baseline gap-1 font-display text-brand">
                <span class="text-numeral">{fact.figure}</span>
                <span class="text-h2">{fact.unit}</span>
              </p>
              <p class="mt-6 max-w-sm text-balance text-body-lg">{fact.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-14 rounded-xl bg-green-50 p-6 md:p-10 lg:mt-20">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="font-display text-overline uppercase text-brand">Illustration, not a quote</p>
          <p class="text-body-sm text-ink">Round figures, for one room.</p>
        </div>
        <dl class="mt-8 grid gap-6 md:grid-cols-[1fr_auto_1fr_auto_1.15fr] md:items-end md:gap-8">
          <div>
            <dt class="text-label text-ink">A room rents for</dt>
            <dd class="mt-1 font-sans text-h2 font-bold tabular-nums text-brand">UGX 400,000</dd>
          </div>
          <div class="hidden font-display text-h1 text-brand md:block" aria-hidden="true">−</div>
          <div>
            <dt class="text-label text-ink">Our 15% is</dt>
            <dd class="mt-1 font-sans text-h2 font-bold tabular-nums text-brand">UGX 60,000</dd>
          </div>
          <div class="hidden font-display text-h1 text-brand md:block" aria-hidden="true">=</div>
          <div class="rounded-lg bg-white p-4">
            <dt class="text-label text-ink">You receive on the 1st</dt>
            <dd class="mt-1 font-sans text-h2 font-bold tabular-nums text-brand">UGX 340,000</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 3 · Tenants. Two cards, one white and one Green, overlap a sage band. -->
  <section aria-label="For tenants" class="relative bg-surface pb-16 md:pb-24">
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 top-44 bg-sage-100"></div>
    <div class="relative mx-auto max-w-page px-6 lg:px-8">
      <p class="font-display text-overline uppercase text-brand">For tenants: homes, shops and offices</p>
      <div class="mt-6 grid gap-6 lg:grid-cols-12">
        <article
          id="rent"
          class="scroll-mt-6 rounded-xl bg-surface p-6 shadow-md md:p-10 lg:col-span-7"
          aria-labelledby="rent-heading"
        >
          <Badge size="xl">
            <Icon family="pictogram" name="tenant-management" class="h-14 text-accent" />
          </Badge>
          <h2 id="rent-heading" class="mt-8 text-h2">Pay your rent</h2>
          <span class="arrival-rule mt-4 block h-1 w-16 bg-accent" aria-hidden="true"></span>
          <p class="mt-4 text-body-lg">
            Pay your rent to Mwavuli only, by mobile money or bank. Never pay cash to our staff.
          </p>
          <p class="mt-4 text-body-lg">Your rent is due on the day written in your tenancy form.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Placeholder>Mobile money number to be added</Placeholder>
            <Placeholder>Bank account to be added</Placeholder>
          </div>
        </article>

        <article
          id="problem"
          class="on-inverse scroll-mt-6 rounded-xl bg-brand p-6 text-white md:p-10 lg:col-span-5"
          aria-labelledby="problem-heading"
        >
          <Badge size="xl" tone="deep">
            <Icon family="pictogram" name="construction-repairs" class="h-14 text-accent" />
          </Badge>
          <h2 id="problem-heading" class="mt-8 text-h2 text-white">Report a problem</h2>
          <span class="arrival-rule mt-4 block h-1 w-16 bg-accent" aria-hidden="true"></span>
          <p class="mt-4 text-body-lg">
            Tell us by phone or WhatsApp if something is broken or unsafe. We arrange a trusted
            contractor.
          </p>
          <div class="mt-8">
            <Placeholder tone="inverse">Phone or WhatsApp number to be added</Placeholder>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4 · The pull statement: the purpose, then the six services as in the card back. -->
  <section
    aria-labelledby="services-heading"
    class="on-inverse relative isolate overflow-hidden bg-brand-deep text-white"
  >
    <RoofBands variant="services" />
    <div class="relative mx-auto max-w-page px-6 py-16 text-center md:py-24 lg:px-8">
      <h2 id="services-heading" class="mx-auto max-w-4xl text-h1 text-white md:text-display">
        Professional property management for people and businesses in Uganda.
      </h2>
      <div class="mx-auto mt-8 h-1 w-16 bg-accent" aria-hidden="true"></div>
      <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:mt-20 lg:grid-cols-6">
        {
          services.map((service) => (
            <li class="flex flex-col items-center gap-5">
              <Badge size="2xl">
                <Icon family="pictogram" name={service.name} class={`${service.height} text-accent`} />
              </Badge>
              <span class="max-w-40 font-display text-body font-semibold text-white">{service.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="mx-auto mt-14 max-w-2xl text-body-lg text-cream lg:mt-20">
        If a tenant doesn’t pay, we cover that first month and do the chasing.
      </p>
    </div>
  </section>

  <!-- 5 · Contact, on cream. No portal and no login: people talk to us. -->
  <section id="contact" aria-labelledby="contact-heading" class="scroll-mt-6 bg-page py-16 md:py-24">
    <div class="mx-auto grid max-w-page gap-12 px-6 lg:grid-cols-12 lg:gap-8 lg:px-8">
      <div class="lg:col-span-5 lg:self-center">
        <p class="font-display text-overline uppercase text-brand">For everyone</p>
        <h2 id="contact-heading" class="mt-4 text-h1 md:text-display">Talk to us</h2>
        <span class="arrival-rule mt-4 block h-1 w-16 bg-accent" aria-hidden="true"></span>
        <p class="mt-4 max-w-sm text-body-lg">Phone or WhatsApp us, or write to us.</p>
      </div>
      <dl class="grid gap-4 lg:col-span-7">
        <div class="flex items-center gap-5 rounded-xl bg-surface p-5 shadow-md md:p-6">
          <Icon family="pictogram" name="badge-phone" class="size-14 text-brand" />
          <div>
            <dt class="font-display text-h4 text-brand">Phone or WhatsApp</dt>
            <dd class="mt-2"><Placeholder>Number to be added</Placeholder></dd>
          </div>
        </div>
        <div class="flex items-center gap-5 rounded-xl bg-surface p-5 shadow-md md:p-6 lg:ml-10">
          <Icon family="pictogram" name="badge-location" class="size-14 text-brand" />
          <div>
            <dt class="font-display text-h4 text-brand">Post</dt>
            <dd class="mt-2 text-body-lg">{POSTAL_ADDRESS}</dd>
          </div>
        </div>
        <div class="flex items-center gap-5 rounded-xl bg-surface p-5 shadow-md md:p-6 lg:ml-20">
          <Badge>
            <Icon name="mail" class="size-8 text-white" />
          </Badge>
          <div>
            <dt class="font-display text-h4 text-brand">Email</dt>
            <dd class="mt-2"><Placeholder>Address to be added</Placeholder></dd>
          </div>
        </div>
      </dl>
    </div>
  </section>
</Layout>
