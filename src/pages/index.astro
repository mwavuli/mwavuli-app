---
import Contact from '../components/Contact.astro';
import Numbers from '../components/Numbers.astro';
import SentenceHero from '../components/SentenceHero.astro';
import Services from '../components/Services.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Adds the `js` class before the first paint, so the sentence shows without a flash of the no-JS list. -->
  <script is:inline slot="head">
    document.documentElement.classList.add('js');
  </script>

  <SentenceHero />
  <Numbers />
  <Services />
  <Contact />
</Layout>
